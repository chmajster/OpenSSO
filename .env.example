OPENSSO_PORT=8080
OPENSSO_PUBLIC_URL=http://localhost:8080
OPENSSO_COOKIE_SECURE=false
# Set true only when the API is reachable exclusively through a trusted reverse proxy.
OPENSSO_TRUST_PROXY_HEADERS=true

# Generate both values before first start. Do not reuse examples in production.
POSTGRES_PASSWORD=
OPENSSO_BOOTSTRAP_TOKEN=
OPENSSO_MASTER_KEY=
